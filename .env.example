# Copy to `.env` (git-ignored) and edit. Every variable the process reads is
# listed here with the default `src/config.py` applies when it is unset.
#
# DATABASE_URL and REDIS_URL use the docker-compose service hostnames. Running
# the app outside compose means swapping `postgres`/`redis` for `localhost`.

# --- auth -------------------------------------------------------------------
JWT_SECRET=dev-secret-not-for-production
JWT_AUDIENCE=ema-universal-sql

# --- backing services -------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/universal_sql
REDIS_URL=redis://redis:6379/0

# --- budgets and TTLs (milliseconds) ----------------------------------------
# Per-request deadline; parent of the per-source budgets (Phase 1/2).
REQUEST_TIMEOUT_MS=5000
# In-process TTL for control-plane reads (src/control_plane/repository.py).
CONTROL_PLANE_TTL_MS=30000
# Default freshness window for the connector result cache (Phase 1).
CACHE_TTL_MS=60000

# --- test hooks -------------------------------------------------------------
# 1 enables POST /v1/test/reset (Playwright beforeEach, k6 runs). 0 → 404.
TEST_MODE=0

# --- Added in Phase 0 review ---------------------------------------------
# Scopes minted into a demo token. RFC 8693 §4.2 format: space-delimited.
# The gateway requires `query:execute` before a query is planned.
DEFAULT_SCOPES=query:execute

# Where spans go. ADR-016 keeps this backend-free (no Jaeger/OTLP container).
#   file    - JSONL at OTEL_TRACE_FILE; this is Phase 4's waterfall artifact
#   console - stdout, for local debugging
#   none    - export nothing; use for the k6 load run, where exporting is
#             measurement overhead on the very latency being measured
OTEL_EXPORTER=file
OTEL_TRACE_FILE=traces/spans.jsonl

LOG_LEVEL=INFO
